{
  "name": "quotagate",
  "version": "0.1.0",
  "description": "Local OpenAI-compatible proxy that routes requests through Claude Code, Gemini CLI, and Codex CLI",
  "type": "module",
  "license": "MIT",
  "author": "jxtSamFrimpong (https://github.com/jxtSamFrimpong)",
  "homepage": "https://github.com/jxtSamFrimpong/Quotagate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jxtSamFrimpong/Quotagate.git"
  },
  "bugs": {
    "url": "https://github.com/jxtSamFrimpong/Quotagate/issues"
  },
  "keywords": [
    "openai",
    "proxy",
    "claude-code",
    "gemini-cli",
    "codex-cli",
    "mcp",
    "llm",
    "openai-compatible"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.ts\" \"*.js\""
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.0.0",
    "openai": "^6.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.8"
  }
}
